{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tabiya Player",
  "version": "1.5.1",
  "identifier": "com.nick.simply-chess",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5185",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "create": false,
        "title": "Tabiya Player",
        "width": 1087,
        "height": 807,
        "minWidth": 960,
        "minHeight": 720,
        "resizable": true,
        "center": true,
        "label": "main"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "publisher": "Nicholas Walker",
    "copyright": "Copyright (c) 2026 Nicholas Walker",
    "shortDescription": "A no-frills chess game against Stockfish",
    "longDescription": "Play chess against Stockfish on one screen, at eight levels, with the engine's evaluation on a bar, a hint when you want one, the game in progress remembered, and a review afterwards that names every slip and the move the engine preferred.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh",
        "compression": "zlib"
      }
    }
  }
}
